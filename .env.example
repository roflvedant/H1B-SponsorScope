# JSearch credential used by fetch_main.py and the POST /search endpoint.
JSEARCH_API_KEY=replace_with_your_jsearch_api_key

# JSearch endpoint. Most users can leave this unchanged.
JSEARCH_URL=https://api.openwebninja.com/jsearch/search-v2

# Local Docker PostgreSQL connection.
# Deployment will replace this with the hosted database URL.
DATABASE_URL=postgresql+psycopg://h1b_user:h1b_password@localhost:5432/h1b_jobs

# Optional custom data directory.
# Leave this commented to use <project-root>/data.
# DATA_DIRECTORY=C:/path/to/h1b_project/data